JSONBIN_BIN_ID=YOUR_PRIVATE_BIN_ID
# Access Key must allow both reading and updating the selected Bin.
JSONBIN_ACCESS_KEY=YOUR_READ_WRITE_ACCESS_KEY
# Alternatively set JSONBIN_MASTER_KEY (server only); it takes precedence.
LICENSE_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Connect a Private Vercel Blob store to the project to provision this automatically.
BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_BLOB_TOKEN
